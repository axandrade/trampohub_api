FROM jenkins/jenkins:lts

USER root
RUN apt-get update && apt-get install -y \
    maven \
    git \
    curl \
    wget \
    docker.io \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Adicionar jenkins ao grupo docker (que já existe)
RUN usermod -aG docker jenkins

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Container inicia como root para poder ajustar a permissão do
# docker.sock montado do host; o entrypoint baixa privilégio para
# o usuário jenkins via gosu antes de executar o Jenkins.
ENTRYPOINT ["/entrypoint.sh"]